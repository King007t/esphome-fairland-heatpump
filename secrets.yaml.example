# Secrets used by example.yaml. In the ESPHome Device Builder add-on open "Secrets"
# and add these entries (wifi_ssid and wifi_password usually exist already).
wifi_ssid: "MyWiFi"
wifi_password: "wifi-password"

# Password of the fallback access point (at least 8 characters)
ap_password: "fairland1234"

# 32 random bytes, base64 encoded, e.g. the key the add-on generated for the device.
# The same key is used for OTA updates. The placeholder below is rejected on purpose;
# generate a key with "openssl rand -base64 32" or copy the one from the add-on.
api_encryption_key: "REPLACE-WITH-32-RANDOM-BYTES-BASE64"
